{
  "name": "marknest",
  "version": "1.0.0",
  "description": "Local-first markdown notes web app: live preview, tags, full-text search, IndexedDB storage, offline PWA.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "markdown",
    "notes",
    "pwa",
    "offline",
    "local-first",
    "indexeddb",
    "vite",
    "typescript"
  ],
  "author": "Ha2mad",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  }
}
